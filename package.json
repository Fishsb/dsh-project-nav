{
  "name": "@dsh-external/project-nav",
  "version": "0.2.9",
  "description": "DSH plugin: anti-drift project governance — bidirectional feature<->file mapping, mainline vector, governance-first action ledger (plan/begin/done), and a reference-docs registry consulted at plan time. v0.2.9: findStaleFiles accepts workspace-relative file keys (fixes mass false stale); nav_map HTML readability — module display names, per-feature user/system views, project disk paths, how-to-read guide.",
  "type": "module",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "shared",
    "package.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./host/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "project-nav",
    "governance",
    "project-governance",
    "project-management",
    "anti-drift",
    "drift-detection",
    "architecture",
    "feature-map",
    "knowledge-graph",
    "documentation"
  ],
  "license": "BSD-3-Clause",
  "author": "Fishsb (lk)",
  "homepage": "https://github.com/Fishsb/dsh-project-nav#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fishsb/dsh-project-nav.git"
  },
  "bugs": {
    "url": "https://github.com/Fishsb/dsh-project-nav/issues"
  }
}